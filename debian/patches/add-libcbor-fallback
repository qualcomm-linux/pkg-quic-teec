Index: pkg-quic-teec/libqcomtee/CMakeLists.txt
===================================================================
--- pkg-quic-teec.orig/libqcomtee/CMakeLists.txt
+++ pkg-quic-teec/libqcomtee/CMakeLists.txt
@@ -12,7 +12,15 @@ set(QCBOR_DIR_HINT "" CACHE PATH "Hint p
 
 find_package(QCBOR REQUIRED)
 if(NOT QCBOR_FOUND)
-	message(FATAL_ERROR "QCBOR not found")
+	message(WARNING "QCBOR not found, falling back to libcbor")
+	set(USE_LIBCBOR TRUE)
+else()
+	set(USE_LIBCBOR FALSE)
+endif()
+
+if(USE_LIBCBOR)
+	add_compile_definitions(${PROJECT_NAME}
+		PRIVATE -DUSE_LIBCBOR)
 endif()
 
 include_directories(${QCBOR_INCLUDE_DIRS})
@@ -46,9 +54,11 @@ target_include_directories(qcomtee
 	PRIVATE src
 )
 
-target_link_libraries(qcomtee
-	PRIVATE ${QCBOR_LIBRARIES}
-)
+if(NOT USE_LIBCBOR)
+	target_link_libraries(qcomtee PRIVATE ${QCBOR_LIBRARIES})
+else()
+	target_link_libraries(qcomtee PRIVATE cbor)
+endif()
 
 # ''Install targets''.
 
Index: pkg-quic-teec/libqcomtee/src/objects/credentials_obj.c
===================================================================
--- pkg-quic-teec.orig/libqcomtee/src/objects/credentials_obj.c
+++ pkg-quic-teec/libqcomtee/src/objects/credentials_obj.c
@@ -4,8 +4,13 @@
 #include <stdlib.h>
 #include <unistd.h>
 #include <sys/time.h>
-#include <qcbor/qcbor.h>
 #include <qcomtee_object_types.h>
+#ifndef USE_LIBCBOR
+#include <qcbor/qcbor.h>
+#else
+#include <cbor.h>
+#include <string.h>
+#endif
 
 #define IIO_OP_GET_LENGTH 0
 #define IIO_OP_READ_AT_OFFSET 1
@@ -29,6 +34,7 @@ enum {
 };
 
 #define CREDENTIALS_BUF_SIZE_INC 4096
+#ifndef USE_LIBCBOR
 static int realloc_useful_buf(UsefulBuf *buf)
 {
 	void *ptr;
@@ -43,10 +49,27 @@ static int realloc_useful_buf(UsefulBuf
 
 	return 0;
 }
+#else
+static int alloc_cbor_mutable_data(cbor_mutable_data *buffer, size_t* buffer_size)
+{
+	void* ptr;
+
+	ptr = malloc(CREDENTIALS_BUF_SIZE_INC * sizeof(unsigned char));
+	if (!ptr)
+		return -1;
+
+	*buffer = (unsigned char*)ptr;
+	*buffer_size += CREDENTIALS_BUF_SIZE_INC;
+	memset(*buffer, 0, *buffer_size);
+
+	return 0;
+}
+#endif
 
 /* Get credentials. */
 static int credentials_init(struct qcomtee_ubuf *ubuf)
 {
+#ifndef USE_LIBCBOR
 	QCBOREncodeContext e_ctx;
 	UsefulBufC enc;
 	UsefulBuf creds_useful_buf = { NULL, 0 };
@@ -71,6 +94,53 @@ static int credentials_init(struct qcomt
 	ubuf->size = enc.len;
 
 	return 0;
+#else
+	cbor_mutable_data buffer = NULL;
+	cbor_item_t *creds_map = NULL;
+	struct cbor_pair map_pair;
+	size_t buffer_size = 0;
+	int ret = -1;
+
+	if (alloc_cbor_mutable_data(&buffer, &buffer_size))
+		goto exit;
+
+	creds_map = cbor_new_definite_map(2);
+	if (creds_map == NULL)
+		goto exit;
+
+	map_pair.key = cbor_build_uint8(attr_uid);
+	map_pair.value = cbor_build_uint32((uint32_t)getuid());
+	if(!cbor_map_add(creds_map, map_pair)) {
+		cbor_decref(&map_pair.key);
+		cbor_decref(&map_pair.value);
+		goto exit;
+	}
+
+	map_pair.key = cbor_build_uint8(attr_system_time);
+	map_pair.value = cbor_build_uint64((uint64_t)get_time_in_ms());
+	if(!cbor_map_add(creds_map, map_pair)) {
+		cbor_decref(&map_pair.key);
+		cbor_decref(&map_pair.value);
+		goto exit;
+	}
+
+	buffer_size = cbor_serialize_map(creds_map, buffer, buffer_size);
+	if (buffer_size == 0)
+		goto exit;
+
+	/* Mark success of encoding */
+	ret = 0;
+
+	ubuf->addr = (void *)buffer;
+	ubuf->size = buffer_size;
+
+exit:
+	if(ret != 0 && buffer)
+		free(buffer);
+	if(creds_map)
+		cbor_decref(&creds_map);
+	return ret;
+#endif
 }
 
